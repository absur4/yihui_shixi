{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/middleware-benchmark/unified-result-2.0.schema.json",
  "title": "Unified communication middleware benchmark suite result (output/result.json)",
  "type": "object",
  "required": [
    "schema_version",
    "metrics_definition_version",
    "middleware_id",
    "status",
    "planned_runs",
    "test_start_time",
    "environment",
    "configuration",
    "scenario_summaries",
    "runs",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "metrics_definition_version": {"const": "1.0"},
    "statistical_level": {"type": "string"},
    "run_id": {"type": "string", "minLength": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "middleware_id": {"const": "dds"},
    "middleware_label": {"type": "string"},
    "middleware_version": {"type": ["string", "null"]},
    "vendor": {"type": "string"},
    "status": {"$ref": "#/$defs/status"},
    "planned_runs": {"$ref": "#/$defs/nonnegativeInteger"},
    "test_start_time": {"type": "string"},
    "test_end_time": {"type": ["string", "null"]},
    "environment": {"type": "object"},
    "configuration": {"type": "object"},
    "units": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "scenario_summaries": {"type": "array", "items": {"$ref": "#/$defs/summary"}},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "status": {
      "enum": ["completed", "error", "cancelled", "timeout", "unsupported", "not_tested"]
    },
    "nullableNumber": {"type": ["number", "null"]},
    "nullableInteger": {"type": ["integer", "null"]},
    "nonnegativeInteger": {"type": "integer", "minimum": 0},
    "metricSummary": {
      "type": "object",
      "required": ["mean", "min", "max", "std_population"],
      "properties": {
        "mean": {"type": "number"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "std_population": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "metricSummaryOrNull": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/metricSummary"}
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "middleware_id",
        "scenario_id",
        "scenario_name",
        "condition_id",
        "condition_ids",
        "attempted_repeats",
        "repeat_count",
        "valid_repeats",
        "formal_minimum_met",
        "capability",
        "metrics"
      ],
      "properties": {
        "middleware_id": {"const": "dds"},
        "scenario_id": {"type": ["string", "null"]},
        "scenario_name": {"type": ["string", "null"]},
        "scenario_title": {"type": ["string", "null"]},
        "condition_id": {"type": ["string", "null"]},
        "condition_ids": {"type": "array", "items": {"type": "string"}},
        "group_key": {"type": "object"},
        "status": {"$ref": "#/$defs/status"},
        "attempted_repeats": {"$ref": "#/$defs/nonnegativeInteger"},
        "repeat_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "valid_repeats": {"$ref": "#/$defs/nonnegativeInteger"},
        "formal_minimum_met": {"type": "boolean"},
        "capability": {"type": "string"},
        "metrics": {"type": "object"},
        "latency_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_p95_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_p99_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_std_ms": {"$ref": "#/$defs/nullableNumber"},
        "jitter_ms": {"$ref": "#/$defs/nullableNumber"},
        "throughput_mbps": {"$ref": "#/$defs/nullableNumber"},
        "offered_throughput_mbps": {"$ref": "#/$defs/nullableNumber"},
        "cpu_percent": {"$ref": "#/$defs/nullableNumber"},
        "memory_mb": {"$ref": "#/$defs/nullableNumber"},
        "packet_loss": {"$ref": "#/$defs/nullableNumber"},
        "final_packet_loss": {"$ref": "#/$defs/nullableNumber"},
        "startup_time_ms": {"$ref": "#/$defs/nullableNumber"},
        "discovery_time_ms": {"$ref": "#/$defs/nullableNumber"},
        "recovery_time_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_drift_ms": {"$ref": "#/$defs/nullableNumber"},
        "memory_growth_mb": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "middleware_id",
        "middleware_version",
        "scenario_name",
        "scenario_title",
        "repeat",
        "status",
        "payload_size_bytes",
        "publish_rate_hz",
        "publisher_count",
        "subscriber_count",
        "messages_sent",
        "messages_received",
        "unique_deliveries",
        "expected_deliveries",
        "achieved_publish_rate_hz",
        "latency_ms",
        "latency_p95_ms",
        "latency_p99_ms",
        "latency_std_ms",
        "throughput_mbps",
        "jitter_ms",
        "packet_loss",
        "final_packet_loss",
        "duplicate_count",
        "out_of_order_count",
        "corrupted_count",
        "startup_time_ms",
        "discovery_time_ms",
        "recovery_time_ms",
        "cpu_percent",
        "memory_mb",
        "latency_sample_count",
        "configuration",
        "statistics",
        "link_metrics",
        "environment",
        "limitations"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "suite_id": {"type": ["string", "null"]},
        "middleware_id": {"const": "dds"},
        "middleware_label": {"type": ["string", "null"]},
        "middleware_version": {"type": ["string", "null"]},
        "vendor": {"type": ["string", "null"]},
        "measurement_engine": {"type": ["string", "null"]},
        "scenario_id": {"type": ["string", "null"]},
        "scenario_name": {"type": ["string", "null"]},
        "scenario_title": {"type": ["string", "null"]},
        "condition_id": {"type": ["string", "null"]},
        "case": {"type": ["string", "null"]},
        "repeat": {"$ref": "#/$defs/nullableInteger"},
        "status": {"$ref": "#/$defs/status"},
        "capability": {"type": "string"},
        "payload_size_bytes": {"$ref": "#/$defs/nullableInteger"},
        "publish_rate_hz": {"type": ["number", "null"]},
        "publisher_count": {"$ref": "#/$defs/nullableInteger"},
        "subscriber_count": {"$ref": "#/$defs/nullableInteger"},
        "messages_sent": {"$ref": "#/$defs/nullableInteger"},
        "messages_received": {"$ref": "#/$defs/nullableInteger"},
        "unique_deliveries": {"$ref": "#/$defs/nullableInteger"},
        "expected_deliveries": {"$ref": "#/$defs/nullableInteger"},
        "achieved_publish_rate_hz": {"$ref": "#/$defs/nullableNumber"},
        "latency_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_p95_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_p99_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_std_ms": {"$ref": "#/$defs/nullableNumber"},
        "throughput_mbps": {"$ref": "#/$defs/nullableNumber"},
        "jitter_ms": {"$ref": "#/$defs/nullableNumber"},
        "packet_loss": {"$ref": "#/$defs/nullableNumber"},
        "final_packet_loss": {"$ref": "#/$defs/nullableNumber"},
        "duplicate_count": {"$ref": "#/$defs/nullableInteger"},
        "out_of_order_count": {"$ref": "#/$defs/nullableInteger"},
        "corrupted_count": {"$ref": "#/$defs/nullableInteger"},
        "startup_time_ms": {"$ref": "#/$defs/nullableNumber"},
        "discovery_time_ms": {"$ref": "#/$defs/nullableNumber"},
        "recovery_time_ms": {"$ref": "#/$defs/nullableNumber"},
        "cpu_percent": {"$ref": "#/$defs/nullableNumber"},
        "memory_mb": {"$ref": "#/$defs/nullableNumber"},
        "latency_sample_count": {"$ref": "#/$defs/nullableInteger"},
        "configuration": {"type": "object"},
        "statistics": {"type": "object"},
        "link_metrics": {"type": "array", "items": {"type": "object"}},
        "environment": {"type": "object"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}},
        "transport_mode": {"type": ["string", "null"]},
        "transport_detail": {"type": ["string", "null"]},
        "qos_profile": {"type": ["string", "null"]},
        "network_profile": {"type": ["string", "null"]},
        "rate_scope": {"const": "per_publisher"},
        "resource_scope": {"type": "string"},
        "discovery_ready_condition": {"type": "string"},
        "recovery_semantics": {"type": "string"},
        "rate_calibration": {"type": "object"},
        "fault_events": {"type": "array", "items": {"type": "object"}},
        "restart_count": {"$ref": "#/$defs/nullableInteger"},
        "samples_path": {"type": ["string", "null"]},
        "artifacts_directory": {"type": ["string", "null"]},
        "artifacts": {"type": "object"},
        "timing_details": {"type": "object"},
        "resource_details": {"type": "object"},
        "test_start_time": {"type": ["string", "null"]},
        "test_end_time": {"type": ["string", "null"]}
      }
    }
  }
}
