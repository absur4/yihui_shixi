{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/middleware-benchmark/unified-result-1.0.schema.json",
  "title": "Unified communication middleware benchmark result",
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "metrics_definition_version",
    "module_name",
    "module_version",
    "adapter_version",
    "suite_start_time",
    "suite_end_time",
    "environment",
    "runs",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"type": "string", "minLength": 1},
    "metrics_definition_version": {"const": "1.0"},
    "module_name": {"type": "string", "minLength": 1},
    "module_version": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "suite_start_time": {"type": "string"},
    "suite_end_time": {"type": ["string", "null"]},
    "environment": {"type": "object"},
    "config_source": {"type": "string"},
    "config_warnings": {"type": "array", "items": {"type": "string"}},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
    "summary": {"type": "array", "items": {"$ref": "#/$defs/summary"}}
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "nonnegativeInteger": {"type": "integer", "minimum": 0},
    "metricSummary": {
      "type": "object",
      "required": ["mean", "min", "max", "std_population"],
      "properties": {
        "mean": {"type": "number"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "std_population": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "metricSummaryOrNull": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/metricSummary"}
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "group_key",
        "condition_ids",
        "attempted_repeats",
        "valid_repeats",
        "formal_minimum_met",
        "metrics"
      ],
      "properties": {
        "group_key": {
          "type": "object",
          "required": [
            "module_name",
            "scenario_name",
            "payload_size_bytes",
            "publish_rate_hz",
            "publisher_count",
            "subscriber_count",
            "transport_mode",
            "qos_profile",
            "network_profile"
          ],
          "properties": {
            "module_name": {"type": "string"},
            "scenario_name": {"type": "string"},
            "payload_size_bytes": {"type": "integer", "minimum": 1},
            "publish_rate_hz": {"type": "number", "minimum": 0},
            "publisher_count": {"type": "integer", "minimum": 1},
            "subscriber_count": {"type": "integer", "minimum": 1},
            "transport_mode": {"type": "string"},
            "qos_profile": {"type": "string"},
            "network_profile": {"type": "string"}
          },
          "additionalProperties": false
        },
        "condition_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "attempted_repeats": {"$ref": "#/$defs/nonnegativeInteger"},
        "valid_repeats": {"$ref": "#/$defs/nonnegativeInteger"},
        "formal_minimum_met": {"type": "boolean"},
        "metrics": {
          "type": "object",
          "required": [
            "latency_ms",
            "latency_p95_ms",
            "latency_p99_ms",
            "latency_std_ms",
            "jitter_ms",
            "throughput_mbps",
            "offered_throughput_mbps",
            "cpu_percent",
            "memory_mb",
            "packet_loss",
            "final_packet_loss",
            "startup_time_ms",
            "discovery_time_ms",
            "recovery_time_ms",
            "latency_drift_ms",
            "memory_growth_mb"
          ],
          "properties": {
            "latency_ms": {"$ref": "#/$defs/metricSummaryOrNull"},
            "latency_p95_ms": {"$ref": "#/$defs/metricSummaryOrNull"},
            "latency_p99_ms": {"$ref": "#/$defs/metricSummaryOrNull"},
            "latency_std_ms": {"$ref": "#/$defs/metricSummaryOrNull"},
            "jitter_ms": {"$ref": "#/$defs/metricSummaryOrNull"},
            "throughput_mbps": {"$ref": "#/$defs/metricSummaryOrNull"},
            "offered_throughput_mbps": {"$ref": "#/$defs/metricSummaryOrNull"},
            "cpu_percent": {"$ref": "#/$defs/metricSummaryOrNull"},
            "memory_mb": {"$ref": "#/$defs/metricSummaryOrNull"},
            "packet_loss": {"$ref": "#/$defs/metricSummaryOrNull"},
            "final_packet_loss": {"$ref": "#/$defs/metricSummaryOrNull"},
            "startup_time_ms": {"$ref": "#/$defs/metricSummaryOrNull"},
            "discovery_time_ms": {"$ref": "#/$defs/metricSummaryOrNull"},
            "recovery_time_ms": {"$ref": "#/$defs/metricSummaryOrNull"},
            "latency_drift_ms": {"$ref": "#/$defs/metricSummaryOrNull"},
            "memory_growth_mb": {"$ref": "#/$defs/metricSummaryOrNull"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "schema_version",
        "metrics_definition_version",
        "module_name",
        "module_version",
        "measurement_engine",
        "adapter_version",
        "run_id",
        "condition_id",
        "scenario_id",
        "scenario_name",
        "repeat_index",
        "status",
        "payload_size_bytes",
        "message_count",
        "publish_rate_hz",
        "publisher_count",
        "subscriber_count",
        "transport_mode",
        "qos_profile",
        "network_profile",
        "effective_config",
        "latency_ms",
        "latency_p95_ms",
        "latency_p99_ms",
        "latency_std_ms",
        "jitter_ms",
        "throughput_mbps",
        "offered_throughput_mbps",
        "cpu_percent",
        "memory_mb",
        "packet_loss",
        "final_packet_loss",
        "startup_time_ms",
        "discovery_time_ms",
        "recovery_time_ms",
        "latency_drift_ms",
        "memory_growth_mb",
        "network_injected_packet_loss",
        "latency_sample_count",
        "jitter_sample_count",
        "sent_success_count",
        "sent_failure_count",
        "expected_delivery_count",
        "received_before_count",
        "valid_unique_delivery_count",
        "receive_attempt_count",
        "duplicate_count",
        "out_of_order_count",
        "corrupted_count",
        "unexpected_count",
        "clock_anomaly_count",
        "metadata_mismatch_count",
        "duplicate_send_count",
        "malformed_send_count",
        "recovered_count",
        "test_start_time",
        "test_end_time",
        "discovery_supported",
        "errors",
        "warnings",
        "per_link",
        "artifacts"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "metrics_definition_version": {"const": "1.0"},
        "module_name": {"type": "string"},
        "module_version": {"type": "string"},
        "measurement_engine": {"type": "string"},
        "adapter_version": {"type": "string"},
        "run_id": {"type": "string"},
        "condition_id": {"type": "string"},
        "scenario_id": {"type": "string"},
        "scenario_name": {"type": "string"},
        "repeat_index": {"type": "integer", "minimum": 1},
        "status": {"enum": ["passed", "failed"]},
        "payload_size_bytes": {"type": "integer", "minimum": 1},
        "message_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "publish_rate_hz": {"type": "number", "minimum": 0},
        "publisher_count": {"type": "integer", "minimum": 1},
        "subscriber_count": {"type": "integer", "minimum": 1},
        "transport_mode": {"type": "string"},
        "qos_profile": {"type": "string"},
        "network_profile": {"type": "string"},
        "effective_config": {"type": "object"},
        "latency_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_p95_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_p99_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_std_ms": {"$ref": "#/$defs/nullableNumber"},
        "jitter_ms": {"$ref": "#/$defs/nullableNumber"},
        "throughput_mbps": {"$ref": "#/$defs/nullableNumber"},
        "offered_throughput_mbps": {"$ref": "#/$defs/nullableNumber"},
        "cpu_percent": {"$ref": "#/$defs/nullableNumber"},
        "memory_mb": {"$ref": "#/$defs/nullableNumber"},
        "packet_loss": {"$ref": "#/$defs/nullableNumber"},
        "final_packet_loss": {"$ref": "#/$defs/nullableNumber"},
        "startup_time_ms": {"$ref": "#/$defs/nullableNumber"},
        "discovery_time_ms": {"$ref": "#/$defs/nullableNumber"},
        "recovery_time_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_drift_ms": {"$ref": "#/$defs/nullableNumber"},
        "memory_growth_mb": {"$ref": "#/$defs/nullableNumber"},
        "network_injected_packet_loss": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latency_sample_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "jitter_sample_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "sent_success_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "sent_failure_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "expected_delivery_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "received_before_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "valid_unique_delivery_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "receive_attempt_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "duplicate_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "out_of_order_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "corrupted_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "unexpected_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "clock_anomaly_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "metadata_mismatch_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "duplicate_send_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "malformed_send_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "recovered_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "test_start_time": {"type": "string"},
        "test_end_time": {"type": "string"},
        "discovery_supported": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "per_link": {"type": "array", "items": {"type": "object"}},
        "artifacts": {"type": "object"}
      }
    }
  }
}
