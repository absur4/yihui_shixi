{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified middleware benchmark result 2.1",
  "type": "object",
  "required": ["schema_version", "metric_definition_version", "module_name", "module_version", "run_id", "status", "runs", "scenario_summaries"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "metric_definition_version": {"const": "1.0"},
    "module_name": {"type": "string"},
    "module_version": {"type": "string"},
    "run_id": {"type": "string"},
    "status": {"enum": ["running", "completed", "cancelled", "error"]},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
    "scenario_summaries": {"type": "array"}
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "run": {
      "type": "object",
      "required": ["schema_version", "metric_definition_version", "module_name", "module_version", "run_id", "scenario_id", "scenario_name", "repeat", "status", "payload_size_bytes", "actual_payload_size_bytes", "publish_rate_hz", "publisher_count", "subscriber_count", "transport_mode", "qos_profile", "network_profile", "latency_ms", "latency_p95_ms", "latency_p99_ms", "latency_std_ms", "throughput_mbps", "cpu_percent", "memory_mb", "packet_loss", "final_packet_loss", "startup_time_ms", "discovery_time_ms", "discovery_supported", "jitter_ms", "messages_planned", "messages_sent", "messages_received", "expected_deliveries", "duplicate_count", "out_of_order_count", "corrupted_count", "test_start_time", "test_end_time", "configuration", "errors"],
      "properties": {
        "schema_version": {"const": "2.1"},
        "metric_definition_version": {"const": "1.0"},
        "scenario_id": {"type": ["string", "null"], "pattern": "^S(0[1-9]|1[0-2])$"},
        "status": {"enum": ["completed", "error", "not_tested", "unsupported"]},
        "payload_size_bytes": {"type": "integer", "minimum": 1},
        "actual_payload_size_bytes": {"type": "integer", "minimum": 1},
        "publish_rate_hz": {"type": "number", "minimum": 0},
        "publisher_count": {"type": "integer", "minimum": 1},
        "subscriber_count": {"type": "integer", "minimum": 1},
        "packet_loss": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "final_packet_loss": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "duplicate_count": {"type": "integer", "minimum": 0},
        "out_of_order_count": {"type": "integer", "minimum": 0},
        "corrupted_count": {"type": "integer", "minimum": 0},
        "errors": {"type": "array"},
        "configuration": {"type": "object"}
      }
    }
  }
}
