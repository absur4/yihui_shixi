{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zenoh/result.schema.json",
  "title": "Zenoh unified single-run result",
  "type": "object",
  "required": [
    "run_id", "middleware_id", "middleware_version", "scenario_name", "scenario_title", "repeat", "status",
    "payload_size_bytes", "publish_rate_hz", "publisher_count", "subscriber_count",
    "messages_sent", "messages_received", "unique_deliveries", "expected_deliveries",
    "achieved_publish_rate_hz", "latency_ms", "latency_p95_ms", "latency_p99_ms", "latency_std_ms",
    "throughput_mbps", "jitter_ms", "packet_loss", "final_packet_loss", "duplicate_count",
    "out_of_order_count", "corrupted_count", "startup_time_ms", "discovery_time_ms", "recovery_time_ms",
    "cpu_percent", "memory_mb", "latency_sample_count", "configuration", "statistics", "link_metrics",
    "environment", "limitations", "test_start_time", "test_end_time"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "middleware_id": {"const": "zenoh"},
    "middleware_version": {"type": "string"},
    "scenario_name": {"pattern": "^S(0[1-9]|1[0-2])$"},
    "scenario_title": {"type": "string"},
    "repeat": {"type": "integer", "minimum": 1},
    "status": {"enum": ["completed", "error", "cancelled", "timeout", "unsupported", "not_tested"]},
    "payload_size_bytes": {"type": "integer", "minimum": 1},
    "publish_rate_hz": {"type": "number", "minimum": 0},
    "publisher_count": {"type": "integer", "minimum": 1},
    "subscriber_count": {"type": "integer", "minimum": 1},
    "messages_sent": {"type": ["integer", "null"], "minimum": 0},
    "messages_received": {"type": ["integer", "null"], "minimum": 0},
    "unique_deliveries": {"type": ["integer", "null"], "minimum": 0},
    "expected_deliveries": {"type": ["integer", "null"], "minimum": 0},
    "achieved_publish_rate_hz": {"type": ["number", "null"], "minimum": 0},
    "latency_ms": {"type": ["number", "null"]},
    "latency_p95_ms": {"type": ["number", "null"]},
    "latency_p99_ms": {"type": ["number", "null"]},
    "latency_std_ms": {"type": ["number", "null"], "minimum": 0},
    "throughput_mbps": {"type": ["number", "null"], "minimum": 0},
    "jitter_ms": {"type": ["number", "null"], "minimum": 0},
    "packet_loss": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "final_packet_loss": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "duplicate_count": {"type": ["integer", "null"], "minimum": 0},
    "out_of_order_count": {"type": ["integer", "null"], "minimum": 0},
    "corrupted_count": {"type": ["integer", "null"], "minimum": 0},
    "startup_time_ms": {"type": ["number", "null"], "minimum": 0},
    "discovery_time_ms": {"type": ["number", "null"], "minimum": 0},
    "recovery_time_ms": {"type": ["number", "null"], "minimum": 0},
    "cpu_percent": {"type": ["number", "null"], "minimum": 0},
    "memory_mb": {"type": ["number", "null"], "minimum": 0},
    "latency_sample_count": {"type": "integer", "minimum": 0},
    "actual_payload_size_bytes": {"type": ["integer", "null"], "minimum": 1},
    "wire_message_size_bytes": {"type": ["integer", "null"], "minimum": 1},
    "metadata_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "discovery_supported": {"type": "boolean"},
    "configuration": {"type": "object"},
    "statistics": {"type": "object"},
    "link_metrics": {"type": "array"},
    "environment": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "samples": {"type": "array"},
    "measurement_window": {"type": "object"},
    "errors": {"type": "array"},
    "test_start_time": {"type": "string", "format": "date-time"},
    "test_end_time": {"type": "string", "format": "date-time"}
  }
}
